# Supabase credentials (Project Settings → API)
# Copy to .env.local (gitignored) for local dev, and add these to the Vercel
# project's Environment Variables for deploys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Scraper (server-side only; never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional tuning (defaults shown): max sources rendered in parallel, and the
# per-page render timeout in ms.
SCRAPER_CONCURRENCY=5
SCRAPER_RENDER_TIMEOUT_MS=10000

# Run-scraper button: link to the GitHub Actions workflow "Run workflow" page
VITE_GITHUB_WORKFLOW_URL=https://github.com/marcelotust/remote-radar/actions/workflows/daily-scraper.yml
